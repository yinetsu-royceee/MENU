        LinearLayout.LayoutParams textParams = new LinearLayout.LayoutParams(0, WRAP_CONTENT, 1.0f);
        textView.setLayoutParams(textParams);

        final ImageView imgBtn = new ImageView(getContext);
        LinearLayout.LayoutParams imgParams = new LinearLayout.LayoutParams(dp(45), dp(45));
        imgBtn.setLayoutParams(imgParams);
        imgBtn.setScaleType(ImageView.ScaleType.FIT_CENTER);

        final String cacheKey = getCacheKey(featNum, featName);
        Boolean cachedImg = localToggleCache.get(cacheKey);
        boolean imgState;
        if (cachedImg != null) {
            imgState = cachedImg.booleanValue();
        } else {
            imgState = getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).getBoolean("f_" + featNum, swiOn);
            localToggleCache.put(cacheKey, Boolean.valueOf(imgState));
        }
        Preferences.changeFeatureBool(featName, featNum, imgState);
        final boolean[] currentState = {imgState};
        updateToggleImage(imgBtn, currentState[0]);

        imgBtn.setClickable(true);
        imgBtn.setOnClickListener(new View.OnClickListener() {
				@Override
				public void onClick(View v) {

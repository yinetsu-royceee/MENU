    public static void showCustomToast(String msg) {
        if (instance != null) instance.showToast(msg);
    }

    @SuppressWarnings("deprecation")
    public void showToast(String msg) {
        if (getContext == null || msg == null || msg.length() == 0) return;

        try {
            Context toastContext = getContext.getApplicationContext();
            LinearLayout toastContent = new LinearLayout(toastContext);
            toastContent.setOrientation(LinearLayout.HORIZONTAL);
            toastContent.setGravity(Gravity.CENTER_VERTICAL);
            toastContent.setPadding(dp(14), dp(10), dp(18), dp(10));

            GradientDrawable toastBg = new GradientDrawable();
            toastBg.setShape(GradientDrawable.RECTANGLE);
            toastBg.setCornerRadius(dp(24));
            toastBg.setColor(MENU_BG_COLOR);
            toastBg.setStroke(dp(1), ToggleON);
            toastContent.setBackground(toastBg);
            if (Build.VERSION.SDK_INT >= 21) {
                toastContent.setElevation(dp(8));
            }

            TextView accentMark = new TextView(toastContext);
            accentMark.setText("●");
            accentMark.setTextColor(ToggleON);
            accentMark.setTextSize(12f);
            accentMark.setGravity(Gravity.CENTER);
            LinearLayout.LayoutParams markParams =
                new LinearLayout.LayoutParams(dp(18), WRAP_CONTENT);
            markParams.rightMargin = dp(8);
            toastContent.addView(accentMark, markParams);

            TextView toastText = new TextView(toastContext);
            toastText.setText(msg);
            toastText.setTextColor(TEXT_COLOR);
            toastText.setTextSize(13f);
            toastText.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
            toastText.setGravity(Gravity.CENTER_VERTICAL);
            toastText.setMaxLines(2);
            toastText.setEllipsize(TextUtils.TruncateAt.END);
            toastContent.addView(toastText, new LinearLayout.LayoutParams(
									 WRAP_CONTENT, WRAP_CONTENT));

            Toast systemToast = Toast.makeText(toastContext, msg, Toast.LENGTH_SHORT);
            systemToast.setView(toastContent);
            systemToast.setGravity(Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL, 0, dp(88));
            systemToast.show();
        } catch (Throwable customToastError) {
            try {
                Toast.makeText(getContext.getApplicationContext(), msg,
							   Toast.LENGTH_SHORT).show();
            } catch (Throwable ignored) {
                Log.w(TAG, "Unable to display toast", customToastError);
            }
        }
    }

    private void resetAllGameFeatures() {
        Class<?> bridge = getBridgeClass(getContext);
        if (bridge != null) {
            try {
                bridge.getDeclaredMethod("resetAllFeatures").invoke(null);
            } catch (Throwable ignored) { }
        }
        localToggleCache.clear();
        localIntCache.clear();
        localLongCache.clear();
        localStringCache.clear();
        if (globalFeatureList != null) {
            if (mods.getParent() != null) {
                mods.removeAllViews();
                featureList(globalFeatureList, mods, true);
            }
            if (mSettings.getParent() != null) {
                renderSettingsPanel();
            }
        }
        showToast("✓ All game features reset to default");
    }

    public void onDestroy() {
        try { if (rgbHandler != null && rgbRunnable != null) rgbHandler.removeCallbacks(rgbRunnable); } catch (Throwable ignored) { }
        try { if (rootFrame != null && mWindowManager != null && rootFrame.getParent() != null) mWindowManager.removeView(rootFrame); } catch (Throwable ignored) { }
    }

            },
            new int[]{ Color.BLUE, ToggleON, ToggleOFF }
        );
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            try {
                switchR.getThumbDrawable().setTintList(buttonStates);
                switchR.getTrackDrawable().setTintList(buttonStates);
            } catch (NullPointerException ex) { }
        }
        switchR.setText(featName);
        switchR.setTextColor(TEXT_COLOR_2);
        switchR.setTextSize(13f);
        switchR.setTypeface(Typeface.create("sans-serif-condensed", Typeface.NORMAL));
        switchR.setPadding(dp(5), dp(8), dp(5), dp(8));
        final String cacheKey = getCacheKey(featNum, featName);
        Boolean cached = localToggleCache.get(cacheKey);
        boolean isEnabled;
        if (cached != null) {
            isEnabled = cached.booleanValue();
        } else {
            isEnabled = getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).getBoolean("f_" + featNum, swiOn);
            localToggleCache.put(cacheKey, Boolean.valueOf(isEnabled));
        }
        switchR.setChecked(isEnabled);
        Preferences.changeFeatureBool(featName, featNum, isEnabled);
        switchR.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
				public void onCheckedChanged(CompoundButton compoundButton, boolean bool) {
					localToggleCache.put(cacheKey, Boolean.valueOf(bool));
					getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).edit().putBoolean("f_" + featNum, bool).apply();
					Preferences.changeFeatureBool(featName, featNum, bool);

					switch (featNum) {
						case -1:
							Preferences.loadPref = bool;
							Preferences.with(switchR.getContext()).writeBoolean(-1, bool);
							break;
						case -3:
							Preferences.isExpanded = bool;
							RelativeLayout.LayoutParams params = (RelativeLayout.LayoutParams) mExpanded.getLayoutParams();
							int sh = getContext.getResources().getDisplayMetrics().heightPixels;
							if (bool) params.height = (int) (sh * 0.95f);
							else params.height = Math.max(dp(300), (int) (sh * 0.60f));
							mExpanded.setLayoutParams(params);
							break;
					}
				}
			});
        linLayout.addView(switchR);
    }

    private void SeekBar(LinearLayout linLayout, final int featNum, final String featName, final int min, int max) {
        final int safeMax = Math.max(min + 1, max);
        final String cacheKey = getCacheKey(featNum, featName);
        int stored;
        if (localIntCache.containsKey(cacheKey)) {
            stored = localIntCache.get(cacheKey);
        } else {
            stored = getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).getInt("f_" + featNum, min);
        }
        final int initial = Math.max(min, Math.min(safeMax, stored == 0 ? min : stored));
        localIntCache.put(cacheKey, initial);
        Preferences.changeFeatureInt(featName, featNum, initial);

        // Brightness-style rounded capsule card.
        LinearLayout card = new LinearLayout(getContext);
        card.setOrientation(LinearLayout.VERTICAL);
        card.setPadding(dp(13), dp(10), dp(13), dp(8));
        LinearLayout.LayoutParams cardParams = new LinearLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT);
        cardParams.setMargins(dp(5), dp(6), dp(5), dp(6));
        card.setLayoutParams(cardParams);

        GradientDrawable cardBg = new GradientDrawable();
        cardBg.setCornerRadius(dp(18));
        cardBg.setColor(BTN_COLOR);
        cardBg.setStroke(dp(1), blendColors(ToggleON, BTN_COLOR, 0.38f));
        card.setBackground(cardBg);

        LinearLayout heading = new LinearLayout(getContext);
        heading.setOrientation(LinearLayout.HORIZONTAL);
        heading.setGravity(Gravity.CENTER_VERTICAL);

        TextView label = new TextView(getContext);
        label.setText(featName);
        label.setTextColor(TEXT_COLOR_2);
        label.setTextSize(12.5f);
        label.setTypeface(Typeface.create("sans-serif-medium", Typeface.NORMAL));
        LinearLayout.LayoutParams labelParams = new LinearLayout.LayoutParams(0, WRAP_CONTENT, 1f);
        label.setLayoutParams(labelParams);

        final TextView value = new TextView(getContext);
        value.setText(String.valueOf(initial));
        value.setTextColor(TEXT_COLOR);
        value.setTextSize(12f);
        value.setTypeface(Typeface.create("sans-serif", Typeface.BOLD));
        value.setGravity(Gravity.CENTER);
        value.setPadding(dp(10), dp(4), dp(10), dp(4));
        GradientDrawable valueBg = new GradientDrawable();
        valueBg.setCornerRadius(dp(30));
        valueBg.setColor(blendColors(ToggleON, BTN_COLOR, 0.72f));
        valueBg.setStroke(dp(1), ToggleON);
        value.setBackground(valueBg);
        heading.addView(label);
        heading.addView(value);

        final SeekBar seekBar = new SeekBar(getContext);
        seekBar.setMax(safeMax - min);
        seekBar.setProgress(initial - min);
        seekBar.setPadding(dp(2), dp(10), dp(2), dp(5));
        seekBar.setSplitTrack(false);

        // Rounded track and clipped rounded progress create the curved capsule look.
        GradientDrawable track = new GradientDrawable();
        track.setShape(GradientDrawable.RECTANGLE);
        track.setCornerRadius(dp(20));
        track.setColor(blendColors(BTN_COLOR, ToggleOFF, 0.45f));
        GradientDrawable progressShape = new GradientDrawable(
            GradientDrawable.Orientation.LEFT_RIGHT,
            new int[]{ToggleON, SeekBarProgressColor}
        );
        progressShape.setCornerRadius(dp(20));
        ClipDrawable progressClip = new ClipDrawable(progressShape, Gravity.LEFT, ClipDrawable.HORIZONTAL);
        LayerDrawable progressLayers = new LayerDrawable(new android.graphics.drawable.Drawable[]{track, progressClip});
        progressLayers.setId(0, android.R.id.background);
        progressLayers.setId(1, android.R.id.progress);
        seekBar.setProgressDrawable(progressLayers);

        GradientDrawable thumb = new GradientDrawable();
        thumb.setShape(GradientDrawable.OVAL);
        thumb.setColor(Color.WHITE);
        thumb.setStroke(dp(3), ToggleON);
        if (Build.VERSION.SDK_INT >= 16) seekBar.setThumb(thumb);
        seekBar.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
				@Override public void onStartTrackingTouch(SeekBar bar) { }

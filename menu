    private static Class<?> getBridgeClass(Context ctx) {
        String pkg = ctx.getPackageName();
        String[] suffixes = {
            ".RetroBridge", ".GameBridge", ".MenuBridge", ".NativeBridge",
            ".ModBridge", ".MainBridge", ".UnityBridge", ".Menu", ".Bridge"
        };
        for (String suffix : suffixes) {
            try { return Class.forName(pkg + suffix); } catch (Throwable ignored) {}
        }
        try { return Class.forName("com.yinetsu.mod.library.GameBridge"); }
        catch (Throwable ignored) { }
        return null;
    }


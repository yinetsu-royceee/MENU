    private static int blendColors(int c1, int c2, float t) {
        int r = (int) (Color.red(c1) * (1 - t) + Color.red(c2) * t);
        int g = (int) (Color.green(c1) * (1 - t) + Color.green(c2) * t);
        int b = (int) (Color.blue(c1) * (1 - t) + Color.blue(c2) * t);
        return Color.rgb(r, g, b);
    }

    private int clampUiValue(int value, int min, int max, int fallback) {
        if (value < min || value > max) return fallback;
        return value;
    }

    private void restoreStaticTextColors(View view) {
        if (view instanceof TextView) {
            TextView text = (TextView) view;
            Integer original = originalTextColors.get(text);
            if (original != null) text.setTextColor(original.intValue());
            text.setShadowLayer(0f, 0f, 0f, Color.TRANSPARENT);
        }
        if (view instanceof ViewGroup) {
            ViewGroup group = (ViewGroup) view;
            for (int i = 0; i < group.getChildCount(); i++) restoreStaticTextColors(group.getChildAt(i));
        }
    }

    // Twenty distinct stroke motion profiles. The theme index controls both
    // the motion pattern and its speed, without adding external dependencies.
    private int getAnimatedStrokeColor(long now) {
        int index = getCurrentThemeIndex();
        int speedSetting = clampUiValue(getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).getInt("f_-15", 5), 1, 10, 1);
        double speedScale = 0.35d + (speedSetting * 0.18d);
        double speed = (0.0010d + (index * 0.000055d)) * speedScale;
        double phase = now * speed;
        float t;
        switch (index % 8) {
            case 0: t = (float)(0.5d + 0.5d * Math.sin(phase)); break;
            case 1: t = (float)Math.pow(0.5d + 0.5d * Math.sin(phase), 2.0d); break;
            case 2: t = (float)((phase / (Math.PI * 2d)) % 1d); break;
            case 3: t = (float)(0.20d + 0.80d * Math.pow(Math.max(0d, Math.sin(phase)), 7d)); break;
            case 4: t = (float)(1d - Math.abs(((phase / (Math.PI * 2d)) % 1d) * 2d - 1d)); break;
            case 5: t = (float)(0.5d + 0.5d * Math.sin(phase + Math.sin(phase * 0.31d) * 2.2d)); break;
            case 6: t = (float)(0.5d + 0.5d * Math.sin(phase * 0.55d) * Math.cos(phase * 1.35d)); break;
            default: t = (float)((Math.sin(phase * 1.7d) + 1d) * 0.5d); break;
        }
        if (index == 19 || index == 49) {
            float hue = (float)((now / (index == 19 ? 22L : 17L)) % 360L);
            return Color.HSVToColor(new float[]{hue, 0.88f, 1.0f});
        }
        return blendColors(currentTheme.accent, currentTheme.accent2, Math.max(0f, Math.min(1f, t)));
    }

    // Per-label rainbow coloring: staggered hues keep the interface lively while
    // retaining readable brightness. The update is throttled by the main loop.
    private void animateRainbowText(View view, long now, int[] index) {
        if (view instanceof TextView) {
            TextView textView = (TextView) view;

            if (!originalTextColors.containsKey(textView)) {
                originalTextColors.put(textView, Integer.valueOf(textView.getCurrentTextColor()));
            }

            float hue = (float)((now / 24L + index[0] * 31L) % 360L);
            int rainbowColor = Color.HSVToColor(new float[]{hue, 0.58f, 1.0f});

            textView.setTextColor(rainbowColor);

            index[0]++;
        }
        if (view instanceof ViewGroup) {
            ViewGroup group = (ViewGroup)view;
            for (int i = 0; i < group.getChildCount(); i++) {
                animateRainbowText(group.getChildAt(i), now, index);
            }
        }
    }


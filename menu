        // 1. GLITCH EFFECT. The overlay is independent: it never resets the
        // title TextView's marquee, so the running title keeps its own timeline.
        final String originalTitle = titleRef.getText().toString();
        final Handler glitchHandler = new Handler();
        glitchHandler.post(new Runnable() {
				@Override public void run() {
					try {
						if (mExpanded.getVisibility() != View.VISIBLE) {
							glitchHandler.postDelayed(this, 2000);
							return;
						}

						final TextView glitchOverlay = new TextView(getContext);
						glitchOverlay.setTextSize(18.0f);
						glitchOverlay.setTypeface(Typeface.create("sans-serif-black", Typeface.BOLD));
						glitchOverlay.setGravity(Gravity.CENTER);
						glitchOverlay.setTextColor(TEXT_COLOR);
						glitchOverlay.setSingleLine(true);

						RelativeLayout.LayoutParams glParams = new RelativeLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT);
						glParams.addRule(RelativeLayout.CENTER_VERTICAL);
						glParams.leftMargin = dp(34);
						glitchOverlay.setLayoutParams(glParams);
						glitchOverlay.setAlpha(0f);

						titleTextRef.addView(glitchOverlay);

						android.text.SpannableStringBuilder builder = new android.text.SpannableStringBuilder(originalTitle);
						int numGlitches = 2 + (int)(Math.random() * 3);

						for (int i = 0; i < numGlitches; i++) {
							if (originalTitle.length() == 0) break;
							int start = (int)(Math.random() * originalTitle.length());
							int end = Math.min(start + 1, originalTitle.length());

							int[] colors = {0xFF00FFFF, 0xFFFF0055, 0xFFFFFF00};
							int color = colors[(int)(Math.random() * colors.length)];
							float scale = 1.2f + (float)(Math.random() * 0.6f);

							builder.setSpan(new android.text.style.ForegroundColorSpan(color), start, end, android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
							builder.setSpan(new android.text.style.RelativeSizeSpan(scale), start, end, android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);

							if (Math.random() > 0.5) {
								builder.setSpan(new android.text.style.SuperscriptSpan(), start, end, android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
							} else {
								builder.setSpan(new android.text.style.SubscriptSpan(), start, end, android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
							}
						}

						glitchOverlay.setText(builder);
						glitchOverlay.setAlpha(1f);
						glitchOverlay.setTranslationX((float)(Math.random() * 6 - 3));
						glitchOverlay.setTranslationY((float)(Math.random() * 6 - 3));

						glitchOverlay.postDelayed(new Runnable() {
								@Override public void run() {
									glitchOverlay.animate().alpha(0f).setDuration(50).withEndAction(new Runnable() {
											@Override public void run() {
												titleTextRef.removeView(glitchOverlay);
											}
										}).start();
								}
							}, 80);

					} catch (Throwable ignored) { }

					glitchHandler.postDelayed(this, 1500 + (long)(Math.random() * 2500));
				}
			});

        // 2. Continuous subtitle ticker. Keep one canonical phrase and let
        // TextView's infinite marquee loop; do not duplicate/reassign it later.
        final String tickerText = "HONOIKAZUCHI • YINETSU • LIGHT-ZEN • ENGINE • MOD MENU";
        // Duplicate once for a seamless marquee cycle; never append again during glitches/open events.
        subTitleRef.setText(tickerText + "     •     " + tickerText);
        subTitleRef.setSingleLine(true);
        subTitleRef.setHorizontallyScrolling(true);
        subTitleRef.setEllipsize(TextUtils.TruncateAt.MARQUEE);
        subTitleRef.setMarqueeRepeatLimit(-1);
        subTitleRef.setFocusable(true);
        subTitleRef.setFocusableInTouchMode(true);
        subTitleRef.setSelected(true);
    }



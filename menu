            name.setTextSize(9f);
            name.setGravity(Gravity.CENTER);
            name.setTypeface(null, Typeface.BOLD);
            name.setMaxLines(2);
            swatch.addView(name);

            swatch.setClickable(true);
            swatch.setFocusable(true);
            swatch.setOnClickListener(new View.OnClickListener() {
					@Override
					public void onClick(View v) {
						try {
							currentTheme = THEMES[idx];
							getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).edit()
                                .putInt("theme", idx).putString("theme_name", THEMES[idx].name).apply();
							applyThemeLive();
							showCustomToast("🎨 " + THEMES[idx].name + " • " + getThemeMotionName(idx));
						} catch (Throwable e) {
							Log.e(TAG, "Theme Error", e);
						}
					}
				});

            themeRow.addView(swatch);
        }

        themeScroll.addView(themeRow);
        parent.addView(themeScroll);
    }


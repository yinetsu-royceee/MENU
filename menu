            swBg.setOrientation(GradientDrawable.Orientation.TL_BR);
            if (isActive) swBg.setStroke(dp(2), t.accent);
            else swBg.setStroke(dp(1), Color.parseColor("#33FFFFFF"));
            swatch.setBackground(swBg);
            swatch.setPadding(dp(6), dp(8), dp(6), dp(8));

            TextView dot = new TextView(getContext);
            GradientDrawable dotBg = new GradientDrawable();
            dotBg.setShape(GradientDrawable.OVAL);
            dotBg.setColor(t.accent);
            dotBg.setStroke(dp(2), t.accent2);
            dot.setBackground(dotBg);
            LinearLayout.LayoutParams dotLp = new LinearLayout.LayoutParams(dp(28), dp(28));
            dotLp.setMargins(0, 0, 0, dp(6));
            dot.setLayoutParams(dotLp);

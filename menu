					getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).edit().putBoolean("f_" + featNum, currentState[0]).apply();
					Preferences.changeFeatureBool(featName, featNum, currentState[0]);
					updateToggleImage(imgBtn, currentState[0]);
				}
			});

        container.addView(textView);
        container.addView(imgBtn);
        linLayout.addView(container);

    // Overlay windows start non-focusable. Both Search and custom editors must use
    // the same focus hand-off so the IME can attach to the actual EditText.
    private void requestImeFocus(final EditText target) {
        if (target == null || vmParams == null || mWindowManager == null || rootFrame == null) return;
        activeImeField = target;
        try {
            vmParams.flags &= ~WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE;
            vmParams.flags &= ~WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM;
            mWindowManager.updateViewLayout(rootFrame, vmParams);
        } catch (Throwable t) {
            Log.w(TAG, "Unable to enable overlay IME focus", t);
        }
        target.setFocusable(true);
        target.setFocusableInTouchMode(true);
        target.requestFocus();
        target.postDelayed(new Runnable() {
				@Override public void run() {
					if (activeImeField != target || !target.hasFocus()) return;
					InputMethodManager imm = (InputMethodManager)getContext.getSystemService(Context.INPUT_METHOD_SERVICE);
					if (imm != null) {
						boolean shown = imm.showSoftInput(target, InputMethodManager.SHOW_IMPLICIT);
						if (!shown) imm.showSoftInput(target, InputMethodManager.SHOW_FORCED);
					}
				}
			}, 180);
    }

    private void releaseImeFocus(final EditText target) {
        if (target == null || activeImeField != target) return;
        InputMethodManager imm = (InputMethodManager)getContext.getSystemService(Context.INPUT_METHOD_SERVICE);
        if (imm != null) imm.hideSoftInputFromWindow(target.getWindowToken(), 0);
        activeImeField = null;
        if (vmParams != null && mWindowManager != null && rootFrame != null) {
            rootFrame.postDelayed(new Runnable() {
					@Override public void run() {
						if (activeImeField != null) return;
						try {
							vmParams.flags |= WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE;
							vmParams.flags |= WindowManager.LayoutParams.FLAG_ALT_FOCUSABLE_IM;
							mWindowManager.updateViewLayout(rootFrame, vmParams);
						} catch (Throwable t) {
							Log.w(TAG, "Unable to restore overlay focus flags", t);
						}
					}
				}, 220);
        }
    }


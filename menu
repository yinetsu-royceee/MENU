    // Premium panel entrance/exit. The Zenitsu floating button is hidden while the panel is open.
    private void animateMenuOpen() {
        if (mExpanded == null || mCollapsed == null) return;
        hiddenByUser = false;
        mExpanded.animate().cancel();
        mCollapsed.animate().cancel();
        mExpanded.setVisibility(View.VISIBLE);
        // Marquee views stay selected from initial layout; do not restart their scroll here.

        mExpanded.setPivotX(dp(MENU_WIDTH) * 0.5f);
        mExpanded.setPivotY(0f);
        mExpanded.setAlpha(0f);
        mExpanded.setScaleX(0.91f);
        mExpanded.setScaleY(0.91f);
        mExpanded.setTranslationY(dp(18));
        mExpanded.setRotationX(-5f);
        mExpanded.animate().alpha(1f).scaleX(1f).scaleY(1f)
            .translationY(0f).rotationX(0f).setDuration(360)
            .setInterpolator(new DecelerateInterpolator()).start();

        if (mCollapsed.getVisibility() == View.VISIBLE) {
            mCollapsed.animate().alpha(0f).scaleX(0.72f).scaleY(0.72f)
                .setDuration(170).setInterpolator(new AccelerateDecelerateInterpolator())
                .withEndAction(new Runnable() {
                    @Override public void run() {
                        mCollapsed.setVisibility(View.GONE);
                        mCollapsed.setAlpha(ICON_ALPHA);
                        mCollapsed.setScaleX(1f);
                        mCollapsed.setScaleY(1f);
                    }
                }).start();
        } else {
            mCollapsed.setVisibility(View.GONE);
        }
    }

    private void animateMenuClose() {
        if (mExpanded == null || mCollapsed == null) return;
        mExpanded.animate().cancel();
        mCollapsed.animate().cancel();
        mExpanded.animate().alpha(0f).scaleX(0.93f).scaleY(0.93f)
            .translationY(dp(14)).rotationX(4f).setDuration(230)
            .setInterpolator(new AccelerateDecelerateInterpolator())
            .withEndAction(new Runnable() {
                @Override public void run() {
                    mExpanded.setVisibility(View.GONE);
                    mExpanded.setAlpha(1f);
                    mExpanded.setScaleX(1f);
                    mExpanded.setScaleY(1f);
                    mExpanded.setTranslationY(0f);
                    mExpanded.setRotationX(0f);
                    mCollapsed.setVisibility(View.VISIBLE);
                    mCollapsed.setAlpha(0f);
                    mCollapsed.setScaleX(0.72f);
                    mCollapsed.setScaleY(0.72f);
                    mCollapsed.animate().alpha(ICON_ALPHA).scaleX(1f).scaleY(1f)
                        .setDuration(280).setInterpolator(new DecelerateInterpolator()).start();
                }
            }).start();
    }

    public void ShowMenu() {
        rootFrame.addView(mRootContainer);

        final Handler handler = new Handler();
        handler.postDelayed(new Runnable() {
				boolean viewLoaded = false;
				@Override
				public void run() {
					try {
						if (Preferences.loadPref && !IsGameLibLoaded() && !stopChecking) {
							if (!viewLoaded) {
								Category(mods, "Waiting for game...");
								Button(mods, -100, "Force load menu");
								viewLoaded = true;
							}
							handler.postDelayed(this, 600);
						} else {
							String[] items = GetFeatureList();
							if (items == null) throw new IllegalStateException("Null Features");
							globalFeatureList = items;
							applySavedFeatures();
							setupTabs();
							mods.removeAllViews();
							featureList(items, mods, true);
						}
					} catch (Throwable t) {
						Log.e(TAG, "Menu init failed", t);
					}
				}
			}, 500);
    }

    // ==================== PREMIUM TAB SETUP ====================
    private void setupTabs() {
        tabContainer.removeAllViews();
        if (globalFeatureList == null) return;

        boolean first = TextUtils.isEmpty(currentCategory);
        for (String item : globalFeatureList) {
            if (item.startsWith("Category_")) {
                final String catName = item.replace("Category_", "");
                if (first) { currentCategory = catName; first = false; }

                final TextView tabBtn = new TextView(getContext);
                tabBtn.setText(catName);
                tabBtn.setTextSize(11f);
                // Custom Premium Font (Futuristic Condensed)
                tabBtn.setTypeface(Typeface.create("sans-serif-condensed", Typeface.BOLD));
                tabBtn.setGravity(Gravity.CENTER);
                // Glow Effect
                tabBtn.setShadowLayer(8f, 0f, 0f, ToggleON);
                tabBtn.setPadding(dp(5), dp(13), dp(5), dp(13));
                tabBtn.setClickable(true);
                tabBtn.setFocusable(true);

                LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT);
                lp.setMargins(0, 0, 0, dp(5));
                tabBtn.setLayoutParams(lp);

                final boolean isActive = catName.equals(currentCategory);
                GradientDrawable tabBg = new GradientDrawable();
                tabBg.setCornerRadius(dp(10));
                if (isActive) {
                    tabBg.setColor(blendColors(ToggleON, MENU_BG_COLOR, 0.75f));
                    tabBg.setStroke(dp(1), ToggleON);
                    tabBtn.setTextColor(ToggleON);
                } else {
                    tabBg.setColor(Color.parseColor("#0A0E14"));
                    tabBg.setStroke(dp(1), Color.parseColor("#2A3B4C"));
                    tabBtn.setTextColor(Color.parseColor("#8899AA"));
                }
                tabBtn.setBackground(tabBg);

                // Pulsing glow for active tab
                if (isActive) {
                    ObjectAnimator pulse = ObjectAnimator.ofFloat(tabBtn, "alpha", 0.7f, 1.0f);
                    pulse.setDuration(1200);
                    pulse.setRepeatCount(ObjectAnimator.INFINITE);
                    pulse.setRepeatMode(ObjectAnimator.REVERSE);
                    pulse.start();
                }

                tabBtn.setOnTouchListener(new View.OnTouchListener() {
						@Override
						public boolean onTouch(View v, MotionEvent event) {
							if (event.getAction() == MotionEvent.ACTION_DOWN) v.setAlpha(0.5f);
							else if (event.getAction() == MotionEvent.ACTION_UP || event.getAction() == MotionEvent.ACTION_CANCEL) v.setAlpha(1.0f);
							return false;
						}
					});

                tabBtn.setOnClickListener(new View.OnClickListener() {
						@Override
						public void onClick(View v) {
							if (!currentCategory.equals(catName)) {
								currentCategory = catName;

								// Slide animation without fading to avoid the dimming effect
								mods.animate().translationX(dp(40)).setDuration(120).withEndAction(new Runnable() {
										public void run() {
											mods.setVisibility(View.INVISIBLE);
											mods.removeAllViews();
											featureList(globalFeatureList, mods, true);
											mods.setTranslationX(-dp(40));
											mods.setVisibility(View.VISIBLE);
											mods.animate().translationX(0).setDuration(180).setInterpolator(new DecelerateInterpolator()).start();
										}
									}).start();

								boolean isRainbowOn = getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).getBoolean("f_-11", true);
								// Update tab highlights
								for (int j = 0; j < tabContainer.getChildCount(); j++) {
									View child = tabContainer.getChildAt(j);
									if (child instanceof TextView) {
										TextView b = (TextView) child;
										String text = b.getText().toString();
										GradientDrawable bg = new GradientDrawable();
										bg.setCornerRadius(dp(8));
										if (text.equals(currentCategory)) {
											bg.setColor(blendColors(ToggleON, MENU_BG_COLOR, 0.75f));
											bg.setStroke(dp(2), ToggleON);
											if (!isRainbowOn) b.setTextColor(ToggleON);
										} else {
											bg.setColor(Color.parseColor("#0A0E14"));
											bg.setStroke(dp(1), Color.parseColor("#2A3B4C"));
											if (!isRainbowOn) b.setTextColor(Color.parseColor("#8899AA"));
										}
										b.setBackground(bg);
									}
								}
                                originalTextColors.clear();
							}
						}
					});

                tabContainer.addView(tabBtn);
            }
        }
    }


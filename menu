    public Menu(final Context context) {
        instance = this;
        getContext = context;
        Preferences.context = context;

        // Load theme by stable name first. Migrate legacy index-only preferences safely.
        android.content.SharedPreferences themePrefs =
            getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE);
        int savedTheme = 0; // Cyberpunk Yellow is the first-run default.
        String savedThemeName = themePrefs.getString("theme_name", null);
        if (savedThemeName != null) {
            for (int i = 0; i < THEMES.length; i++) {
                if (THEMES[i].name.equals(savedThemeName)) {
                    savedTheme = i;
                    break;
                }
            }
        } else if (themePrefs.contains("theme")) {
            int legacyIndex = themePrefs.getInt("theme", 0);
            // Old order: Classic Cyan, Matrix Green, Nebula Purple, Cyberpunk Yellow...
            if (legacyIndex == 0) savedTheme = 1;
            else if (legacyIndex == 1) savedTheme = 2;
            else if (legacyIndex == 2) savedTheme = 3;
            else if (legacyIndex == 3) savedTheme = 0;
            else if (legacyIndex >= 4 && legacyIndex < THEMES.length) savedTheme = legacyIndex;
        }
        if (savedTheme < 0 || savedTheme >= THEMES.length) savedTheme = 0;
        currentTheme = THEMES[savedTheme];
        themePrefs.edit().putString("theme_name", currentTheme.name)
            .putInt("theme", savedTheme).apply();
        applyThemeToFields();

        rootFrame = new FrameLayout(context);
        rootFrame.setOnTouchListener(onTouchListener());
        mRootContainer = new RelativeLayout(context);
        mCollapsed = new RelativeLayout(context);
        mCollapsed.setVisibility(View.VISIBLE);
        mCollapsed.setAlpha(ICON_ALPHA);

        // ========== MAIN MENU BOX ==========
        mExpanded = new LinearLayout(context);
        mExpanded.setVisibility(View.GONE);
        mExpanded.setOrientation(LinearLayout.VERTICAL);
        mExpanded.setPadding(dp(13), dp(13), dp(13), dp(12));
        mExpanded.setClipChildren(false);
        mExpanded.setClipToPadding(false);

        int screenHeight = context.getResources().getDisplayMetrics().heightPixels;
        boolean isExpanded = Preferences.loadPrefBool("Resize UI vertically", -3, false);
        int menuMaxHeight = isExpanded ? (int) (screenHeight * 0.95f) : Math.max(dp(340), (int) (screenHeight * 0.68f));
        mExpanded.setLayoutParams(new RelativeLayout.LayoutParams(dp(MENU_WIDTH), menuMaxHeight));

        final GradientDrawable gdMenuBody = new GradientDrawable();
        gdMenuBody.setCornerRadius(dp((int) MENU_CORNER));
        gdMenuBody.setColors(new int[]{blendColors(MENU_BG_COLOR, ToggleON, 0.13f), MENU_BG_COLOR, blendColors(MENU_BG_COLOR, Color.BLACK, 0.30f)});
        gdMenuBody.setOrientation(GradientDrawable.Orientation.TL_BR);
        gdMenuBody.setStroke(dp(1), blendColors(ToggleON, MENU_BG_COLOR, 0.24f));
        mExpanded.setBackground(gdMenuBody);

        // Animated UI stroke: every theme has its own motion profile.
        rgbHandler = new Handler();
        rgbRunnable = new Runnable() {
            @Override public void run() {
                try {
                    long now = System.currentTimeMillis();
                    android.content.SharedPreferences sp = getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE);
                    int motionColor = getAnimatedStrokeColor(now);
                    int glow = clampUiValue(sp.getInt("f_-14", 45), 0, 100, 45);
                    int gradientMix = clampUiValue(sp.getInt("f_-16", 45), 0, 100, 45);
                    boolean neonPower = sp.getBoolean("f_-13", true);
                    boolean rainbowText = sp.getBoolean("f_-11", true);
                    boolean motionEnabled = sp.getBoolean("f_-17", true);

                    // FIX: I-refresh agad pag in-OFF ang Rainbow para bumalik sa tamang static theme colors
                    if (rainbowText != lastRainbowState) {
                        lastRainbowState = rainbowText;
                        if (!rainbowText) {
                            originalTextColors.clear();
                            applyThemeLive();
                        }
                    }

                    int strokeColor = neonPower ? motionColor : ToggleON;
                    if (motionEnabled) {
                        gdMenuBody.setStroke(dp(2), strokeColor);
                        float mix = 0.025f + (gradientMix / 100.0f) * 0.18f;
                        gdMenuBody.setColors(new int[]{blendColors(MENU_BG_COLOR, motionColor, mix), MENU_BG_COLOR, blendColors(MENU_BG_COLOR, motionColor, mix * 0.42f)});
                    } else {
                        gdMenuBody.setStroke(dp(2), ToggleON);
                        gdMenuBody.setColors(new int[]{blendColors(MENU_BG_COLOR, ToggleON, 0.08f), MENU_BG_COLOR, MENU_BG_COLOR});
                    }
                    if (iconBgRef != null && startimage != null) {
                        iconBgRef.setStroke(dp(2 + (neonPower ? glow / 55 : 0)), strokeColor);
                        if (iconInnerBgRef != null) {
                            float backingMix = 0.07f + (gradientMix / 100.0f) * 0.08f;
                            int backingAccent = motionEnabled ? motionColor : ToggleON;
                            iconInnerBgRef.setColors(new int[]{
														 blendColors(MENU_FEATURE_BG_COLOR, backingAccent, backingMix),
														 blendColors(MENU_BG_COLOR, backingAccent, backingMix * 0.45f),
														 MENU_BG_COLOR
													 });
                        }
                        startimage.invalidate();
                    }
                    if (titleRef != null) {
                        if (neonPower && glow > 0) titleRef.setShadowLayer(glow / 12.0f, 0f, 0f, strokeColor);
                        else titleRef.setShadowLayer(0f, 0f, 0f, Color.TRANSPARENT);
                    }
                    if (now - lastRainbowTextUpdate >= 145L && mExpanded.getVisibility() == View.VISIBLE) {
                        if (rainbowText && motionEnabled) {
                            int[] textIndex = new int[]{0};
                            animateRainbowText(mExpanded, now, textIndex);
                        } else {
                            restoreStaticTextColors(mExpanded);
                        }
                        lastRainbowTextUpdate = now;
                    }
                    mExpanded.invalidate();
                } catch (Throwable ignored) {
                } finally {
                    if (rgbHandler != null) rgbHandler.postDelayed(this, 70);
                }
            }
        };
        rgbHandler.post(rgbRunnable);

        // ========== ICON ==========
        startimage = new ImageView(context);
        startimage.setLayoutParams(new RelativeLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT));
        int applyDimension = (int) TypedValue.applyDimension(1, ICON_SIZE, context.getResources().getDisplayMetrics());
        startimage.getLayoutParams().height = applyDimension;
        startimage.getLayoutParams().width = applyDimension;
        // Panatilihin ang CENTER_CROP para punuin yung space
        startimage.setScaleType(ImageView.ScaleType.CENTER_CROP);

// Theme-colored backing sits behind transparent/rounded parts of the artwork.
        // It follows the active theme so the icon and its border look like one piece.
        iconInnerBgRef = new GradientDrawable();
        iconInnerBgRef.setShape(GradientDrawable.RECTANGLE);
        iconInnerBgRef.setCornerRadius(dp(14));
        iconInnerBgRef.setColors(new int[]{
									 blendColors(MENU_FEATURE_BG_COLOR, ToggleON, 0.34f),
									 blendColors(MENU_BG_COLOR, ToggleON, 0.18f),
									 MENU_BG_COLOR
								 });
        iconInnerBgRef.setOrientation(GradientDrawable.Orientation.TL_BR);
        startimage.setBackground(iconInnerBgRef);
        startimage.setClipToOutline(true);

        // Ito ang mismong orange border na ipapatong natin (Foreground)
        iconBgRef = new GradientDrawable();
        iconBgRef.setShape(GradientDrawable.RECTANGLE);
        iconBgRef.setCornerRadius(dp(12)); 
        iconBgRef.setColor(Color.TRANSPARENT); 
        iconBgRef.setStroke(dp(3), getAnimatedStrokeColor(System.currentTimeMillis()));

        // I-inset nang kaunti ang stroke para tumapat ito sa mismong artwork,
        // hindi sa mas malaking outer bounds ng ImageView.
        android.graphics.drawable.InsetDrawable fittedIconBorder =
            new android.graphics.drawable.InsetDrawable(iconBgRef, dp(2));
        if (Build.VERSION.SDK_INT >= 23) {
            startimage.setForeground(fittedIconBorder);
        } else {
            startimage.setBackground(fittedIconBorder);
        }

        startimage.setPadding(0, 0, 0, 0); // Zero padding para dumikit na talaga
        boolean zenitsuLoaded = false;
        try {
            int zenitsuRes = getContext.getResources().getIdentifier(
                "floating_ball_on", "drawable", getContext.getPackageName());
            if (zenitsuRes != 0) {
                startimage.setImageResource(zenitsuRes);
                zenitsuLoaded = true;
            }
        } catch (Throwable ignored) { }
        if (!zenitsuLoaded) {
            try {
                java.io.InputStream is = getContext.getAssets().open("floating_ball_on.png");
                android.graphics.Bitmap bitmap = BitmapFactory.decodeStream(is);
                if (is != null) is.close();
                if (bitmap != null) {
                    startimage.setImageBitmap(bitmap);
                    zenitsuLoaded = true;
                }
            } catch (Throwable ignored) { }
        }
        if (!zenitsuLoaded) {
            try {
                byte[] decode = Base64.decode(Icon(), 0);
                startimage.setImageBitmap(BitmapFactory.decodeByteArray(decode, 0, decode.length));
            } catch (Throwable ignored) {
                Log.e(TAG, "Zenitsu floating icon asset is missing.");
            }
        }
        ((ViewGroup.MarginLayoutParams) startimage.getLayoutParams()).topMargin = convertDipToPixels(10);
        startimage.setOnTouchListener(onTouchListener());
        startimage.setOnClickListener(new View.OnClickListener() {
                public void onClick(View view) {
                    if (isViewCollapsed()) animateMenuOpen();
                    else animateMenuClose();
                }
            });

        final String webIconData = ""; // Pilitin nating i-empty para hindi gamitin ang web icon
        WebView wView = null;
        if (webIconData != null && webIconData.length() > 0) {
            wView = new WebView(context);
            wView.setLayoutParams(new RelativeLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT));
            int applyDimension2 = (int) TypedValue.applyDimension(1, ICON_SIZE, context.getResources().getDisplayMetrics());
            wView.getLayoutParams().height = applyDimension2;
            wView.getLayoutParams().width = applyDimension2;
            wView.loadData("<html><head></head><body style=\"margin:0;padding:0\"><img src=\"" + webIconData + "\" width=\"" + ICON_SIZE + "\" height=\"" + ICON_SIZE + "\"></body></html>", "text/html", "utf-8");
            wView.setBackgroundColor(0x00000000);
            wView.setAlpha(ICON_ALPHA);
            wView.getSettings().setCacheMode(WebSettings.LOAD_NO_CACHE);
            wView.setOnTouchListener(onTouchListener());
        }

        // ========== TOP BAR ==========
        titleTextRef = new RelativeLayout(context);
        titleTextRef.setPadding(dp(9), dp(8), dp(8), dp(8));
        titleTextRef.setVerticalGravity(Gravity.CENTER_VERTICAL);
        titleTextRef.setClipChildren(false);
        titleTextRef.setClipToPadding(false);
        GradientDrawable titleCardBg = new GradientDrawable();
        titleCardBg.setCornerRadius(dp(15));
        titleCardBg.setColors(new int[]{blendColors(MENU_FEATURE_BG_COLOR, ToggleON, 0.19f), blendColors(MENU_BG_COLOR, Color.BLACK, 0.12f)});
        titleCardBg.setOrientation(GradientDrawable.Orientation.LEFT_RIGHT);
        titleCardBg.setStroke(dp(1), blendColors(ToggleON, MENU_BG_COLOR, 0.28f));
        titleTextRef.setBackground(titleCardBg);

        titleRef = new TextView(context);
        titleRef.setTextColor(TEXT_COLOR);
        titleRef.setTextSize(17.0f);
        titleRef.setTypeface(Typeface.create("sans-serif-black", Typeface.BOLD));
        titleRef.setShadowLayer(7f, 0f, 0f, blendColors(ToggleON, Color.TRANSPARENT, 0.35f));
        titleRef.setGravity(Gravity.CENTER);
        titleRef.setText("YIN MOD MENU  •  CYBERPUNK CONTROL DECK  •  ");
        // True running header: the title itself scrolls continuously when it exceeds the header width.
        titleRef.setSingleLine(true);
        titleRef.setEllipsize(TextUtils.TruncateAt.MARQUEE);
        titleRef.setMarqueeRepeatLimit(-1);
        titleRef.setHorizontallyScrolling(true);
        titleRef.setSelected(true);
        titleRef.setFocusable(true);
        titleRef.setFocusableInTouchMode(true);

        RelativeLayout.LayoutParams rl = new RelativeLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT);
        rl.addRule(RelativeLayout.CENTER_VERTICAL);
        rl.leftMargin = dp(8);
        rl.rightMargin = dp(48); // Space for the gear icon
        titleRef.setLayoutParams(rl);

        subTitleRef = new TextView(context);
        subTitleRef.setTextColor(Color.parseColor("#8899AA"));
        subTitleRef.setTextSize(9.0f);
        subTitleRef.setText("HONOIKAZUCHI • YINETSU • LIGHT-ZEN • ENGINE • MOD MENU");
        subTitleRef.setGravity(Gravity.LEFT | Gravity.CENTER_VERTICAL);
        subTitleRef.setPadding(dp(3), dp(7), dp(3), dp(9));
        RelativeLayout.LayoutParams rlSub = new RelativeLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT);
        subTitleRef.setLayoutParams(rlSub);

        settingsRef = new TextView(context);
        settingsRef.setText(Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.M ? "⚙" : "\uD83D\uDD27");
        settingsRef.setTextColor(TEXT_COLOR);
        settingsRef.setTypeface(Typeface.DEFAULT_BOLD);
        settingsRef.setShadowLayer(8f, 0f, 0f, ToggleON);
        settingsRef.setTextSize(21.0f);
        settingsRef.setPadding(dp(10), dp(7), dp(10), dp(7));
        RelativeLayout.LayoutParams rlsettings = new RelativeLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT);
        rlsettings.addRule(ALIGN_PARENT_RIGHT);
        rlsettings.addRule(RelativeLayout.CENTER_VERTICAL);
        settingsRef.setLayoutParams(rlsettings);
        settingsRef.setOnClickListener(new View.OnClickListener() {
				boolean settingsOpen;
				@Override
				public void onClick(View v) {
					try {
						settingsOpen = !settingsOpen;
						if (settingsOpen) {
							buildSettingsPanel();
							scrollView.removeView(mods);
							scrollView.addView(mSettings);
							scrollView.scrollTo(0, 0);
						} else {
							scrollView.removeView(mSettings);
							scrollView.addView(mods);
						}
					} catch (IllegalStateException e) { }
				}
			});

        // ========== SETTINGS LIST ==========
        mSettings = new LinearLayout(context);
        mSettings.setOrientation(LinearLayout.VERTICAL);

        // ========== SIDEBAR + CONTENT ==========
        mainBodyRef = new LinearLayout(context);
        mainBodyRef.setOrientation(LinearLayout.HORIZONTAL);
        mainBodyRef.setLayoutParams(new LinearLayout.LayoutParams(MATCH_PARENT, 0, 1.0f));

        GradientDrawable bodyBg = new GradientDrawable();
        bodyBg.setCornerRadius(dp(12));
        bodyBg.setColors(new int[]{blendColors(MENU_FEATURE_BG_COLOR, ToggleON, 0.035f), MENU_FEATURE_BG_COLOR, blendColors(MENU_FEATURE_BG_COLOR, Color.BLACK, 0.10f)});
        bodyBg.setOrientation(GradientDrawable.Orientation.TL_BR);
        bodyBg.setStroke(dp(1), blendColors(ToggleON, MENU_FEATURE_BG_COLOR, 0.72f));
        mainBodyRef.setBackground(bodyBg);

        tabScrollView = new ScrollView(context);
        tabScrollView.setLayoutParams(new LinearLayout.LayoutParams(0, MATCH_PARENT, 0.30f));
        tabScrollView.setVerticalScrollBarEnabled(false);

        GradientDrawable sideBg = new GradientDrawable();
        sideBg.setCornerRadii(new float[]{dp(10), dp(10), 0, 0, 0, 0, dp(10), dp(10)});
        sideBg.setColor(SIDEBAR_BG_COLOR);
        tabScrollView.setBackground(sideBg);

        tabContainer = new LinearLayout(context);
        tabContainer.setOrientation(LinearLayout.VERTICAL);
        tabContainer.setPadding(dp(5), dp(8), dp(5), dp(8));
        tabScrollView.addView(tabContainer);
        mainBodyRef.addView(tabScrollView);

        scrollView = new ScrollView(context);
        scrollView.setLayoutParams(new LinearLayout.LayoutParams(0, MATCH_PARENT, 0.70f));
        scrollView.setPadding(dp(10), dp(5), dp(5), dp(5));
        mods = new LinearLayout(context);
        mods.setOrientation(LinearLayout.VERTICAL);
        scrollView.addView(mods);
        mainBodyRef.addView(scrollView);

        // ========== BOTTOM BAR ==========
        RelativeLayout bottomBar = new RelativeLayout(context);
        bottomBar.setPadding(0, dp(10), 0, 0);
        bottomBar.setVerticalGravity(Gravity.CENTER);

        hideBtnRef = new Button(context);
        RelativeLayout.LayoutParams lParamsHideBtn = new RelativeLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT);
        lParamsHideBtn.addRule(ALIGN_PARENT_LEFT);
        hideBtnRef.setLayoutParams(lParamsHideBtn);
        // Bagong border para sa HIDE/KILL
        GradientDrawable hideBg = new GradientDrawable();
        hideBg.setCornerRadius(dp(11));
        hideBg.setColor(Color.TRANSPARENT);
        hideBg.setStroke(dp(1), Color.parseColor("#FF5252"));
        hideBtnRef.setBackground(hideBg);
        hideBtnRef.setPadding(dp(14), dp(8), dp(14), dp(8));
        hideBtnRef.setText("HIDE/KILL");
        hideBtnRef.setTextSize(11f);
        hideBtnRef.setTextColor(Color.parseColor("#FF5252"));
        hideBtnRef.setOnClickListener(new View.OnClickListener() {
				public void onClick(View view) {
                    if (activeImeField != null) releaseImeFocus(activeImeField);
                    if (searchBar != null) searchBar.clearFocus();
                    removeActiveInputEditor();
                    mExpanded.setVisibility(View.GONE);
                    mExpanded.setAlpha(1f);
                    mExpanded.setScaleX(1f);
                    mExpanded.setScaleY(1f);
                    mExpanded.setTranslationY(0f);
                    mExpanded.setRotationX(0f);
                    mCollapsed.setVisibility(View.VISIBLE);
                    mCollapsed.setAlpha(0f);
                    mCollapsed.setScaleX(1f);
                    mCollapsed.setScaleY(1f);
                    hiddenByUser = true;
                    showCustomToast("Hidden • Tap same spot to reopen");
				}
			});
        hideBtnRef.setOnLongClickListener(new View.OnLongClickListener() {
				public boolean onLongClick(View view) {
                    try {
                        if (activeImeField != null) releaseImeFocus(activeImeField);
                        if (searchBar != null) searchBar.clearFocus();
                        removeActiveInputEditor();
                        Class<?> bridge = getBridgeClass(getContext);
                        if (bridge != null) {
                            try {
                                bridge.getDeclaredMethod("resetAllFeatures").invoke(null);
                            } catch (Throwable ignored) { }
                        }
                        showCustomToast("Menu killed • All features reset");
                        rootFrame.removeView(mRootContainer);
                        mWindowManager.removeView(rootFrame);
                    } catch (Throwable ignored) { }
					return false;
				}
			});

        closeBtnRef = new Button(context);
        RelativeLayout.LayoutParams lParamsCloseBtn = new RelativeLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT);
        lParamsCloseBtn.addRule(ALIGN_PARENT_RIGHT);
        closeBtnRef.setLayoutParams(lParamsCloseBtn);
        // Bagong border para sa MINIMIZE
        GradientDrawable closeBg = new GradientDrawable();
        closeBg.setCornerRadius(dp(11));
        closeBg.setColor(Color.TRANSPARENT);
        closeBg.setStroke(dp(1), ToggleON); // Gagamit ng kulay ng kasalukuyang theme
        closeBtnRef.setBackground(closeBg);
        closeBtnRef.setPadding(dp(14), dp(8), dp(14), dp(8));
        closeBtnRef.setText("MINIMIZE");
        closeBtnRef.setTextSize(11f);
        closeBtnRef.setTextColor(TEXT_COLOR);
        closeBtnRef.setOnClickListener(new View.OnClickListener() {
				public void onClick(View view) {
                    if (activeImeField != null) releaseImeFocus(activeImeField);
                    if (searchBar != null) searchBar.clearFocus();
                    removeActiveInputEditor();
                    animateMenuClose();
				}
			});

        // ========== ASSEMBLE ==========
        mRootContainer.addView(mCollapsed);
        mRootContainer.addView(mExpanded);
        if (wView != null) mCollapsed.addView(wView);
        else mCollapsed.addView(startimage);

        titleTextRef.addView(titleRef);
        titleTextRef.addView(settingsRef);
        // ========== SEARCH BAR ==========
        LinearLayout searchContainer = new LinearLayout(context);
        searchContainer.setLayoutParams(new LinearLayout.LayoutParams(MATCH_PARENT, WRAP_CONTENT));
        searchContainer.setPadding(dp(10), 0, dp(10), dp(8));

        searchBar = new EditText(context);
        searchBar.setHint("🔍 Search feature...");
        searchBar.setTextColor(TEXT_COLOR_2);
        searchBar.setHintTextColor(Color.parseColor("#66FFFFFF"));
        searchBar.setTextSize(12f);
        searchBar.setSingleLine(true);
        searchBar.setFocusable(true);
        searchBar.setFocusableInTouchMode(true);
        searchBar.setImeOptions(android.view.inputmethod.EditorInfo.IME_FLAG_NO_EXTRACT_UI);
        searchBar.setOnTouchListener(new View.OnTouchListener() {
				@Override public boolean onTouch(View v, MotionEvent event) {
					if (event.getAction() == MotionEvent.ACTION_UP) requestImeFocus(searchBar);
					return false;
				}
			});

        searchBar.setOnFocusChangeListener(new View.OnFocusChangeListener() {
				@Override public void onFocusChange(View v, boolean hasFocus) {
					if (!hasFocus && activeImeField == searchBar) releaseImeFocus(searchBar);
				}
			});

        // DONE BUTTON SA KEYBOARD
        searchBar.setOnEditorActionListener(new TextView.OnEditorActionListener() {
				@Override
				public boolean onEditorAction(TextView v, int actionId, android.view.KeyEvent event) {
					if (actionId == android.view.inputmethod.EditorInfo.IME_ACTION_DONE || actionId == android.view.inputmethod.EditorInfo.IME_ACTION_SEARCH) {
						searchBar.clearFocus();
						return true;
					}
					return false;
				}
			});

        GradientDrawable searchBg = new GradientDrawable();
        searchBg.setCornerRadius(dp(15));
        searchBg.setColor(BTN_COLOR);
        searchBg.setStroke(dp(1), blendColors(ToggleON, BTN_COLOR, 0.22f));
        searchBar.setBackground(searchBg);
        searchBar.setPadding(dp(13), dp(10), dp(13), dp(10));

        searchBar.addTextChangedListener(new android.text.TextWatcher() {
				public void afterTextChanged(android.text.Editable s) {
					String query = s.toString().toLowerCase().trim();
					if (globalFeatureList == null) return;

					if (query.isEmpty()) {
						mods.removeAllViews();
						featureList(globalFeatureList, mods, true);
                        searchBar.clearFocus();
						return;
					}

					String foundCategory = null;
					for (String item : globalFeatureList) {
						if (item.startsWith("Category_")) {
							foundCategory = item.replace("Category_", "");
						} else if (item.toLowerCase().contains(query)) {
							if (foundCategory != null && !currentCategory.equals(foundCategory)) {
								currentCategory = foundCategory;

                                boolean isRainbowOn = getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE).getBoolean("f_-11", true);
                                // MANUAL NA I-HIGHLIGHT ANG TAMANG TAB
                                for (int j = 0; j < tabContainer.getChildCount(); j++) {
                                    View child = tabContainer.getChildAt(j);
                                    if (child instanceof TextView) {
                                        TextView b = (TextView) child;
                                        String text = b.getText().toString();
                                        GradientDrawable bg = new GradientDrawable();
                                        bg.setCornerRadius(dp(8));
                                        if (text.equals(currentCategory)) {
                                            bg.setColor(blendColors(ToggleON, MENU_BG_COLOR, 0.75f));
                                            bg.setStroke(dp(2), ToggleON);
                                            if (!isRainbowOn) b.setTextColor(ToggleON);
                                        } else {
                                            bg.setColor(Color.parseColor("#0A0E14"));
                                            bg.setStroke(dp(1), Color.parseColor("#2A3B4C"));
                                            if (!isRainbowOn) b.setTextColor(Color.parseColor("#8899AA"));
                                        }
                                        b.setBackground(bg);
                                    }
                                }
							}
							break;
						}
					}

					mods.removeAllViews();
					for (String item : globalFeatureList) {
						if (!item.startsWith("Category_") && item.toLowerCase().contains(query)) {
							String[] str = item.split("_");
							if (str.length > 1) {
								featureList(new String[]{item}, mods, false);
							}
						}
					}
				}
				public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
				public void onTextChanged(CharSequence s, int start, int before, int count) {}
			});

        searchContainer.addView(searchBar);

        mExpanded.addView(titleTextRef);
        mExpanded.addView(subTitleRef);
        neonDividerRef = new View(context);
        LinearLayout.LayoutParams neonDividerParams = new LinearLayout.LayoutParams(MATCH_PARENT, dp(2));
        neonDividerParams.setMargins(dp(4), 0, dp(4), dp(8));
        neonDividerRef.setLayoutParams(neonDividerParams);
        GradientDrawable neonDividerBg = new GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,
															  new int[]{Color.TRANSPARENT, ToggleON, currentTheme.accent2, Color.TRANSPARENT});

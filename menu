    private View.OnTouchListener onTouchListener() {
        return new View.OnTouchListener() {
            final View collapsedView = mCollapsed;
            final View expandedView = mExpanded;
            private float initialTouchX, initialTouchY;
            private int initialX, initialY;
            public boolean onTouch(View view, MotionEvent motionEvent) {
                switch (motionEvent.getAction()) {
                    case MotionEvent.ACTION_DOWN:
                        initialX = vmParams.x; initialY = vmParams.y;
                        initialTouchX = motionEvent.getRawX(); initialTouchY = motionEvent.getRawY();
                        return true;
                    case MotionEvent.ACTION_UP:
                        int rawX = (int) (motionEvent.getRawX() - initialTouchX);
                        int rawY = (int) (motionEvent.getRawY() - initialTouchY);
                        if (hiddenByUser) {
                            mExpanded.setAlpha(1f); mCollapsed.setAlpha(0f);
                        } else {
                            mExpanded.setAlpha(1f); mCollapsed.setAlpha(ICON_ALPHA);
                        }
                        if (Math.abs(rawX) < dp(8) && Math.abs(rawY) < dp(8)) {
                            try {
                                if (isViewCollapsed()) animateMenuOpen();
                            } catch (Throwable ignored) { }
                        }
                        return true;
                    case MotionEvent.ACTION_MOVE:
                        if (hiddenByUser) {
                            hiddenByUser = false;
                            mCollapsed.setAlpha(ICON_ALPHA);
                        } else {
                            mExpanded.setAlpha(0.7f); mCollapsed.setAlpha(0.7f);
                        }
                        vmParams.x = initialX + ((int) (motionEvent.getRawX() - initialTouchX));
                        vmParams.y = initialY + ((int) (motionEvent.getRawY() - initialTouchY));
                        mWindowManager.updateViewLayout(rootFrame, vmParams);
                        return true;
                    default: return false;
                }
            }
        };
    }

    // Helper para hindi maputol ang feature name kapag may underscore (e.g. My_Super_Mode)
    private String joinFrom(String[] arr, int start) {
        if (start >= arr.length) return "";
        StringBuilder sb = new StringBuilder(arr[start]);
        for (int i = start + 1; i < arr.length; i++) sb.append("_").append(arr[i]);
        return sb.toString();
    }

    private void applySavedFeatures() {
        if (globalFeatureList == null) return;
        android.content.SharedPreferences sp = getContext.getSharedPreferences("menu_prefs", Context.MODE_PRIVATE);
        int subFeat = 0;

        for (int i = 0; i < globalFeatureList.length; i++) {
            String feature = globalFeatureList[i];

            if (feature.startsWith("Category_")) {
                subFeat++;
                continue;
            }

            if (feature.contains("CollapseAdd_")) {
                feature = feature.replaceFirst("CollapseAdd_", "");
            }

            boolean defaultOn = false;
            if (feature.contains("_True")) {
                defaultOn = true;
                feature = feature.replaceFirst("_True", "");
            }

            String[] str = feature.split("_");
            boolean isNum = TextUtils.isDigitsOnly(str[0]) || str[0].matches("-[0-9]*");
            int featNum = isNum ? Integer.parseInt(str[0]) : i - subFeat;
            if (!isNum) subFeat++;

            if (isNum) feature = feature.replaceFirst(str[0] + "_", "");
            String[] strSplit = feature.split("_");
            String type = strSplit[0];
            String name = joinFrom(strSplit, 1);

            // Kung wala pang save sa SharedPreferences, skip natin
            if (!sp.contains("f_" + featNum)) continue;

            switch (type) {
                case "Toggle":
                case "ImageToggle":
                case "CheckBox":
                case "ButtonOnOff":
                    Preferences.changeFeatureBool(name, featNum, sp.getBoolean("f_" + featNum, defaultOn));
                    break;
                case "SeekBar":
                case "Spinner":
                case "CustomSpinner":
                case "SegmentedControl":
                case "InputValue":
                case "RadioButton":
                    Preferences.changeFeatureInt(name, featNum, sp.getInt("f_" + featNum, 0));
                    break;
                case "InputLValue":
                    Preferences.changeFeatureLong(name, featNum, sp.getLong("f_" + featNum, 0L));
                    break;
                case "InputText":
                    Preferences.changeFeatureString(name, featNum, sp.getString("f_" + featNum, ""));
                    break;
            }
        }
    }

    private void featureList(String[] listFT, LinearLayout linearLayout, boolean applyFilter) {
        int subFeat = 0;
        boolean isAdding = false;
        LinearLayout llBak = linearLayout;

        for (int i = 0; i < listFT.length; i++) {
            boolean switchedOn = false;
            String feature = listFT[i];
            if (feature.contains("_True")) {
                switchedOn = true;
                feature = feature.replaceFirst("_True", "");
            }

            if (feature.startsWith("Category_")) {
                String catName = feature.replace("Category_", "");
                isAdding = applyFilter ? catName.equals(currentCategory) : true;
                subFeat++;
                continue;
            }

            linearLayout = llBak;
            if (feature.contains("CollapseAdd_")) {
                linearLayout = mCollapse;
                feature = feature.replaceFirst("CollapseAdd_", "");
            }
            String[] str = feature.split("_");

            boolean isNum = TextUtils.isDigitsOnly(str[0]) || str[0].matches("-[0-9]*");
            int featNum = isNum ? Integer.parseInt(str[0]) : i - subFeat;
            if (!isNum) subFeat++;

            if (applyFilter && !isAdding) continue;

            if (isNum) feature = feature.replaceFirst(str[0] + "_", "");

            String[] strSplit = feature.split("_");
            switch (strSplit[0]) {
                case "Toggle":
                    Switch(linearLayout, featNum, joinFrom(strSplit, 1), switchedOn);
                    // Kapag na-render na yung "Auto size", isingit natin yung Themes
                    if (featNum == -3) {
                        buildThemeSelector(linearLayout);
                    }
                    break;
                case "ImageToggle":
                    ImageToggle(linearLayout, featNum, joinFrom(strSplit, 1), switchedOn);
                    break;
                case "SeekBar":
                    if (strSplit.length >= 4) {
                        try {
                            int minValue = Integer.parseInt(strSplit[1]);
                            int maxValue = Integer.parseInt(strSplit[2]);
                            StringBuilder sliderName = new StringBuilder(strSplit[3]);
                            for (int part = 4; part < strSplit.length; part++) sliderName.append("_").append(strSplit[part]);
                            SeekBar(linearLayout, featNum, sliderName.toString(), minValue, maxValue);
                        } catch (NumberFormatException ignored) { }
                    }
                    break;
                case "Button": Button(linearLayout, featNum, joinFrom(strSplit, 1)); break;
                case "CustomButton": CustomButton(linearLayout, featNum, joinFrom(strSplit, 1)); break;
                case "ButtonOnOff": ButtonOnOff(linearLayout, featNum, joinFrom(strSplit, 1), switchedOn); break;
                case "Spinner":
                case "CustomSpinner":
                    if (strSplit.length >= 3) CustomSpinner(linearLayout, featNum, strSplit[1], strSplit[2]);
                    break;
                case "SegmentedControl":
                    if (strSplit.length >= 3) SegmentedControl(linearLayout, featNum, strSplit[1], strSplit[2]);
                    break;
                case "ActionCard":
                    if (strSplit.length >= 3) {
                        StringBuilder actionDesc = new StringBuilder(strSplit[2]);
                        for (int part = 3; part < strSplit.length; part++) actionDesc.append(" ").append(strSplit[part]);
                        ActionCard(linearLayout, featNum, strSplit[1], actionDesc.toString());
                    }
                    break;
                case "InputText": InputText(linearLayout, featNum, joinFrom(strSplit, 1)); break;
                case "InputValue":
                    if (strSplit.length == 3) InputNum(linearLayout, featNum, strSplit[2], Integer.parseInt(strSplit[1]));
                    if (strSplit.length == 2) InputNum(linearLayout, featNum, strSplit[1], 0);
                    break;
                case "InputLValue":
                    if (strSplit.length == 3) InputLNum(linearLayout, featNum, strSplit[2], Long.parseLong(strSplit[1]));
                    if (strSplit.length == 2) InputLNum(linearLayout, featNum, strSplit[1], 0);
                    break;
                case "CheckBox": CheckBox(linearLayout, featNum, joinFrom(strSplit, 1), switchedOn); break;
                case "RadioButton": RadioButton(linearLayout, featNum, joinFrom(strSplit, 1), strSplit[2]); break;
                case "Collapse": Collapse(linearLayout, joinFrom(strSplit, 1), switchedOn); subFeat++; break;
                case "ButtonLink": subFeat++; ButtonLink(linearLayout, joinFrom(strSplit, 1), strSplit[2]); break;
                case "Category": subFeat++; Category(linearLayout, joinFrom(strSplit, 1)); break;
                case "RichTextView": subFeat++; TextView(linearLayout, joinFrom(strSplit, 1)); break;
                case "RichWebView": subFeat++; WebTextView(linearLayout, joinFrom(strSplit, 1)); break;
            }
        }
    }

    private void ImageToggle(LinearLayout linLayout, final int featNum, final String featName, boolean swiOn) {
        final LinearLayout container = new LinearLayout(getContext);
        container.setOrientation(LinearLayout.HORIZONTAL);
        container.setPadding(dp(10), dp(10), dp(10), dp(10));
        container.setGravity(Gravity.CENTER_VERTICAL);

